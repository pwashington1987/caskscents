---
/** A single review. Whiskey and fragrance share this template. */
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BottlePhoto from '../../../components/BottlePhoto.astro';
import ScoreBig from '../../../components/ScoreBig.astro';
import ScoreRow from '../../../components/ScoreRow.astro';
import BarList from '../../../components/BarList.astro';
import PillList from '../../../components/PillList.astro';
import FactTile from '../../../components/FactTile.astro';
import SeasonBars from '../../../components/SeasonBars.astro';
import DayNightBar from '../../../components/DayNightBar.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { getSite } from '../../../lib/site.ts';
import { viewOf } from '../../../lib/views.ts';
import { similarTo } from '../../../lib/similar.ts';
import { href } from '../../../lib/href.ts';
import { reviewPath, rundownPath } from '../../../lib/paths.ts';
import { absoluteUrl, defaultCard, reviewJsonLd } from '../../../lib/meta.ts';
import { shareCard } from '../../../lib/photos.ts';
import type { World } from '../../../lib/validate.ts';

export async function getStaticPaths() {
  const site = await getSite();
  const paths = (world: World) =>
    site.reviews(world).map((entry) => ({
      params: { world, slug: entry.id },
      props: { world, id: entry.id },
    }));
  return [...paths('whiskey'), ...paths('fragrance')];
}

interface Props {
  world: World;
  id: string;
}
const { world, id } = Astro.props;
const site = await getSite();
const entry = site.review(world, id)!;
const view = viewOf(entry);
const { Content } = await render(entry);

const others = site.reviews(world).map((e) => ({ id: e.id, view: viewOf(e), overall: e.data.ratings.overall }));
const similarIds = similarTo(
  { id, features: view.features, overall: entry.data.ratings.overall },
  others.map((o) => ({ id: o.id, features: o.view.features, overall: o.overall })),
);
const similar = similarIds.map((sid) => others.find((o) => o.id === sid)!);
const appearsIn = site.rundownsContaining(world, id);

const card = shareCard(view.image) ?? defaultCard(world);
const full = (path: string) => absoluteUrl(Astro.site!, import.meta.env.BASE_URL, path);
const jsonLd = reviewJsonLd({
  name: view.name,
  brand: view.brand,
  summary: view.summary,
  url: full(reviewPath(world, id)),
  image: full(card),
  score: entry.data.ratings.overall,
  date: entry.data.reviewedDate,
  world,
});
---

<Base title={`${view.name} review`} description={view.summary} world={world} image={card} article jsonLd={jsonLd}>
  <article>
    <header class="wrap head">
      <p class="meta muted">
        {view.draft && <span class="draft-tag">Draft</span>}
        {view.meta.join(' · ')}
      </p>
      <h1 class="display">{view.name}</h1>
      <p class="summary">{view.summary}</p>
      <div class="photo">
        <BottlePhoto world={world} name={view.name} image={view.image} width={200} eager />
      </div>
      <div class="verdict">
        <ScoreBig value={view.overall} />
        <ul class="facts">
          {view.facts.map((fact, i) => <li class={i === 0 ? '' : 'muted'}>{fact}</li>)}
        </ul>
      </div>
    </header>

    <section class="section wrap">
      <h2 class="display">Scores</h2>
      <div class="scores">
        {view.scores.map((line) => <ScoreRow line={line} />)}
      </div>
    </section>

    <section class="section wrap pair">
      <div>
        <h2 class="display">{view.bars.title}</h2>
        <BarList style={view.bars.style} items={view.bars.items} />
      </div>
      <div>
        <h2 class="display">{view.notes.title}</h2>
        <dl class="notes">
          {
            view.notes.rows.map((row) => (
              <div class="note-row">
                <dt class="label">{row.label}</dt>
                <dd>{row.pills ? <PillList items={row.pills} /> : row.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section wrap">
      <h2 class="display">{view.profile.title}</h2>
      <div class={`profile ${view.profile.seasons ? 'with-seasons' : ''}`}>
        <div class="tiles">
          {view.profile.tiles.map((tile) => <FactTile tile={tile} />)}
        </div>
        {view.profile.seasons && <SeasonBars seasons={view.profile.seasons} />}
        {view.profile.day !== undefined && <DayNightBar day={view.profile.day} />}
      </div>
    </section>

    <section class="section wrap body">
      <div class="prose">
        <h2 class="display">The review</h2>
        <Content />
        {
          view.bestFor && (
            <p class="best-for">
              <span class="label">Best for</span>
              <span class="display line">{view.bestFor}</span>
            </p>
          )
        }
      </div>

      <aside class="aside">
        {
          appearsIn.length > 0 && (
            <div class="block">
              <h2 class="muted small-heading">Appears in</h2>
              <ul class="rundowns">
                {
                  appearsIn.map((r) => (
                    <li>
                      <a href={href(rundownPath(world, r.id))}>
                        <span class="kicker">Rundown · {r.data.items.length} bottles</span>
                        <span class="display rundown-title">{r.data.title}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          )
        }
        {
          similar.length > 0 && (
            <div class="block">
              <h2 class="muted small-heading">If you like this</h2>
              <ul class="similar">
                {
                  similar.map((s) => (
                    <li>
                      <a href={href(reviewPath(world, s.id))}>
                        <span class="display">{s.view.name}</span>
                        <span class="score">{s.view.overall}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          )
        }
        <ShareBar title={`${view.name} review · CaskScents`} />
      </aside>
    </section>
  </article>
</Base>

<style>
  h2.display {
    font-size: var(--text-h2);
    margin-bottom: 1.25rem;
  }

  /* Header: on phones the title leads and the photo sits beside the score. */
  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'meta meta'
      'title title'
      'summary summary'
      'photo verdict';
    column-gap: 1.5rem;
    row-gap: 0.75rem;
    align-items: center;
    padding-block: clamp(1.75rem, 4vw, 3.5rem);
  }
  .meta {
    grid-area: meta;
    font-size: var(--text-xs);
  }
  .draft-tag {
    margin-right: 0.625rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    color: var(--gold);
  }
  h1 {
    grid-area: title;
    font-size: var(--text-4xl);
    line-height: 1;
  }
  .summary {
    grid-area: summary;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    line-height: 1.55;
    color: var(--bone-soft);
    max-width: 40rem;
  }
  .photo {
    grid-area: photo;
    display: flex;
    justify-content: center;
    padding-top: 1rem;
  }
  .verdict {
    grid-area: verdict;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-top: 1rem;
  }
  .facts {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-sm);
  }

  .scores {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.25rem 2.5rem;
  }

  .pair {
    display: grid;
    gap: var(--section-pad) 4rem;
  }
  .notes {
    display: flex;
    flex-direction: column;
  }
  .note-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.875rem;
    border-top: 1px solid var(--rule);
  }
  .note-row dd {
    color: var(--bone-soft);
    line-height: 1.5;
  }

  .profile {
    display: grid;
    gap: 1.5rem 3rem;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    align-content: start;
  }

  .body {
    display: grid;
    gap: var(--section-pad) 4rem;
  }
  .prose {
    max-width: 46rem;
  }
  .prose :global(p) {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--bone-soft);
    margin-bottom: 1rem;
  }
  .prose :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose .best-for {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--accent);
  }
  .best-for .line {
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.3;
    color: var(--bone);
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-content: start;
  }
  .small-heading {
    font-size: var(--text-xs);
    font-weight: 400;
    margin-bottom: 0.5rem;
  }
  .rundowns a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  .kicker {
    font-size: var(--text-xs);
    color: var(--accent-text);
  }
  .rundown-title {
    font-size: var(--text-xl);
    line-height: 1.15;
  }
  .similar a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.25rem;
    border-top: 1px solid var(--rule);
    font-size: 1.1875rem;
  }
  .similar li:last-child a {
    border-bottom: 1px solid var(--rule);
  }
  .similar .score {
    font-size: 1rem;
  }

  @media (min-width: 860px) {
    .head {
      grid-template-columns: minmax(14rem, 1fr) 2fr;
      grid-template-areas:
        'photo meta'
        'photo title'
        'photo summary'
        'photo verdict';
      column-gap: 3rem;
      row-gap: 1rem;
    }
    .photo,
    .verdict {
      padding-top: 0;
    }
    .verdict {
      flex-direction: row;
      align-items: flex-end;
      gap: 2.5rem;
      margin-top: 0.75rem;
    }
    .pair {
      grid-template-columns: 5fr 7fr;
    }
    .profile.with-seasons {
      grid-template-columns: 1fr 1fr 1fr;
      align-items: start;
    }
    .profile.with-seasons .tiles {
      grid-template-columns: 1fr;
    }
    .body {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
