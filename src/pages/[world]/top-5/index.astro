---
/** Every Top 5 list in a world. Titles and intros only: who made each list is on its own page. */
import Base from '../../../layouts/Base.astro';
import { getTop5 } from '../../../lib/top5-lists.ts';
import { href } from '../../../lib/href.ts';
import { top5Path, worldTitle } from '../../../lib/paths.ts';
import type { World } from '../../../lib/validate.ts';

export function getStaticPaths() {
  return [{ params: { world: 'whiskey' } }, { params: { world: 'fragrance' } }];
}

const world = Astro.params.world as World;
const title = worldTitle(world);
const lists = (await getTop5()).forWorld(world);
---

<Base
  title={`${title} Top 5 lists`}
  description={`The five best ${world === 'whiskey' ? 'whiskeys' : 'fragrances'} in each category, ranked.`}
  world={world}
>
  <header class="wrap head">
    <p class="label">{title}</p>
    <h1 class="display">Top 5</h1>
    <p class="intro">
      Five to a list, ranked. Most lists are worked out from my scores and change as I review more. A few are
      my own picks.
    </p>
  </header>

  <section class="wrap list">
    {lists.length === 0 && <p class="muted empty">The first lists are on their way.</p>}
    <ul>
      {
        lists.map((list) => (
          <li>
            <a href={href(top5Path(world, list.id))}>
              <span class="text">
                <span class="display title">{list.view.title}</span>
                {list.view.intro && <span class="summary">{list.view.intro}</span>}
              </span>
              <span class="muted side">{list.view.basis === 'score' ? 'Ranked by score' : 'My picks'}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(1.75rem, 4vw, 3.5rem) 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h1 {
    font-size: var(--text-4xl);
  }
  .intro {
    color: var(--bone-soft);
    max-width: 36rem;
  }
  .list {
    padding-bottom: var(--section-pad);
  }
  a {
    display: grid;
    gap: 0.5rem 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  li:last-child a {
    border-bottom: 1px solid var(--rule);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--bone);
  }
  .title {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem);
    line-height: 1.12;
    transition: color 200ms var(--ease);
  }
  a:hover .title {
    color: var(--accent-text);
  }
  .summary {
    font-size: 0.9375rem;
    color: var(--bone-soft);
    max-width: 40rem;
  }
  .side {
    font-size: var(--text-xs);
  }
  .empty {
    padding-block: 1rem;
  }
  @media (min-width: 860px) {
    a {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
  }
</style>
