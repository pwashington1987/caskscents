---
/** One Top 5 list: the five rows, how they were ranked, and the other lists. */
import Base from '../../../layouts/Base.astro';
import ShareBar from '../../../components/ShareBar.astro';
import Top5Rows from '../../../components/Top5Rows.astro';
import { getTop5 } from '../../../lib/top5-lists.ts';
import { href } from '../../../lib/href.ts';
import { formatDate } from '../../../lib/labels.ts';
import { top5IndexPath, top5Path, worldTitle } from '../../../lib/paths.ts';
import type { World } from '../../../lib/validate.ts';

export async function getStaticPaths() {
  const top5 = await getTop5();
  return (['whiskey', 'fragrance'] as const).flatMap((world) =>
    top5.forWorld(world).map((list) => ({ params: { world, slug: list.id }, props: { id: list.id } })),
  );
}

interface Props {
  id: string;
}
const { id } = Astro.props;
const world = Astro.params.world as World;
const top5 = await getTop5();
const lists = top5.forWorld(world);
const list = lists.find((l) => l.id === id)!;
const { view } = list;
const others = lists.filter((l) => l.id !== id);

const basis = view.basis === 'score' ? 'Ranked by score' : 'My picks';
const description = view.intro ?? `A CaskScents Top 5: ${view.title}.`;
---

<Base title={`Top 5: ${view.title}`} description={description} world={world} article>
  <article>
    <header class="wrap head">
      <p class="kicker">
        {list.data.draft && <span class="draft">Draft</span>}
        <a class="label" href={href(top5IndexPath(world))}>{worldTitle(world)} · Top 5</a>
      </p>
      <h1 class="display">{view.title}</h1>
      {view.intro && <p class="intro">{view.intro}</p>}
      <p class="muted basis">{basis} · Updated {formatDate(view.updated)}</p>
    </header>

    <section class="wrap">
      <Top5Rows view={view} />
      <div class="share">
        <ShareBar title={`Top 5: ${view.title}`} />
      </div>
    </section>

    {
      others.length > 0 && (
        <section class="section wrap more">
          <h2 class="display">More Top 5 lists</h2>
          <ul>
            {others.map((other) => (
              <li>
                <a href={href(top5Path(world, other.id))}>{other.view.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(1.75rem, 4vw, 3.5rem) 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .kicker a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-text);
  }
  .draft {
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    font-size: var(--text-xs);
    color: var(--gold);
  }
  h1 {
    font-size: var(--text-4xl);
    max-width: 18ch;
  }
  .intro {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--bone-soft);
    max-width: 40rem;
  }
  .basis {
    font-size: var(--text-xs);
  }
  .share {
    margin-top: 2rem;
  }
  .more h2 {
    font-size: var(--text-h2);
    margin-bottom: 1rem;
  }
  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.125rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--text-sm);
    transition:
      border-color 200ms var(--ease),
      color 200ms var(--ease);
  }
  .more a:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }
</style>
