---
/** Every rundown in a world, newest first. */
import Base from '../../../layouts/Base.astro';
import { getSite } from '../../../lib/site.ts';
import { href } from '../../../lib/href.ts';
import { plural } from '../../../lib/labels.ts';
import { rundownPath, worldTitle } from '../../../lib/paths.ts';
import type { World } from '../../../lib/validate.ts';

export function getStaticPaths() {
  return [{ params: { world: 'whiskey' } }, { params: { world: 'fragrance' } }];
}

const world = Astro.params.world as World;
const site = await getSite();
const rundowns = site.rundownsFor(world).map((r) => ({
  id: r.id,
  title: r.data.title,
  summary: r.data.summary,
  count: r.data.items.length,
  pick: r.data.picks[0],
  winner: site.review(world, r.data.picks[0].winner)?.data.name ?? '',
}));
const title = worldTitle(world);
---

<Base
  title={`${title} rundowns`}
  description={`Side-by-side ${world} comparisons, with a winner for each reason you might be buying.`}
  world={world}
>
  <header class="wrap head">
    <p class="label">{title}</p>
    <h1 class="display">Rundowns</h1>
    <p class="intro">Two to four bottles, one table, and a winner for each reason you might be buying.</p>
  </header>

  <section class="wrap list">
    {rundowns.length === 0 && <p class="muted empty">The first rundown is on its way.</p>}
    <ol>
      {
        rundowns.map((r, index) => (
          <li>
            <a href={href(rundownPath(world, r.id))}>
              <span class="number muted">{String(index + 1).padStart(2, '0')}</span>
              <span class="text">
                <span class="display title">{r.title}</span>
                <span class="summary">{r.summary}</span>
              </span>
              <span class="side">
                <span class="muted">{plural(r.count, 'bottle')}</span>
                <span class="pick">
                  {r.pick.useCase}: {r.winner}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(1.75rem, 4vw, 3.5rem) 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h1 {
    font-size: var(--text-4xl);
  }
  .intro {
    color: var(--bone-soft);
    max-width: 36rem;
  }
  .list {
    padding-bottom: var(--section-pad);
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding-top: 0.5rem;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--bone);
  }
  .title {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem);
    line-height: 1.12;
    transition: color 200ms var(--ease);
  }
  a:hover .title {
    color: var(--accent-text);
  }
  .summary {
    font-size: 0.9375rem;
    color: var(--bone-soft);
    max-width: 40rem;
  }
  .side {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: var(--text-xs);
  }
  .pick {
    color: var(--accent-text);
  }
  .empty {
    padding-block: 1rem;
  }
  @media (min-width: 860px) {
    a {
      grid-template-columns: 3rem 1fr 16rem;
      align-items: start;
    }
    .side {
      grid-column: auto;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      padding-top: 0.5rem;
    }
  }
</style>
