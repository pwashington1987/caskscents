---
/**
 * The gateway: the photographic first screen, then the latest from both
 * worlds, so the root address carries real content.
 */
import Base from '../layouts/Base.astro';
import HeroGateway from '../components/HeroGateway.astro';
import LatestColumn from '../components/LatestColumn.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { getSite } from '../lib/site.ts';
import { listFor } from '../lib/views.ts';
import { rundownView } from '../lib/rundown-view.ts';
import { href } from '../lib/href.ts';
import type { World } from '../lib/validate.ts';

const site = await getSite();
const column = (world: World) => {
  const items = listFor(site, world);
  const viewById = new Map(items.map((i) => [i.id, i.view]));
  const latest = site.rundownsFor(world)[0];
  return {
    world,
    reviews: items.slice(0, 3),
    rundown: latest && {
      id: latest.id,
      view: rundownView(
        latest.data,
        latest.data.items.map((slug) => ({ id: slug, view: viewById.get(slug)! })),
      ),
    },
  };
};
const whiskey = column('whiskey');
const fragrance = column('fragrance');
const hasSignup = Boolean(import.meta.env.PUBLIC_BUTTONDOWN_USERNAME);
---

<Base
  title="CaskScents"
  description="Honest reviews of what you pour and what you wear. Whiskey and fragrance, scored and compared side by side."
  nav={false}
>
  <HeroGateway />

  <section class="wrap latest">
    <h2 class="display">The latest from both worlds</h2>
    <div class="columns">
      <LatestColumn {...whiskey} />
      <LatestColumn {...fragrance} />
    </div>
  </section>

  <section class={`section wrap about ${hasSignup ? 'with-signup' : ''}`}>
    <div class="statement">
      <h2 class="display">One person, two obsessions, no sponsors.</h2>
      <p>
        Every bottle here was bought, opened and lived with before it was scored. The scale is explained in
        plain words.
      </p>
      <a class="how" href={href('/about/scoring/')}>How I score</a>
    </div>
    <EmailSignup />
  </section>
</Base>

<style>
  .latest {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .latest > h2 {
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .columns {
    display: grid;
    gap: 3rem;
  }
  .about {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .statement {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-items: flex-start;
    max-width: 36rem;
  }
  .statement h2 {
    font-size: clamp(1.5rem, 1.3rem + 0.9vw, 1.875rem);
    line-height: 1.2;
  }
  .statement p {
    color: var(--ash-light);
    line-height: 1.6;
  }
  .how {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold);
  }
  @media (min-width: 860px) {
    .columns {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .columns > :global(.column:first-child) {
      padding-right: 3rem;
      border-right: 1px solid var(--rule);
    }
    .columns > :global(.column:last-child) {
      padding-left: 3rem;
    }
    .about.with-signup {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }
</style>
