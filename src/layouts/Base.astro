---
/**
 * The frame around every page: fonts, colors, the top bar and the footer.
 * `world` switches the accent colors and the navigation.
 */
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/manrope/index.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { showDrafts } from '../lib/site.ts';
import { href } from '../lib/href.ts';
import { absoluteUrl, defaultCard, jsonLdText, SITE_NAME } from '../lib/meta.ts';
import { feedPath } from '../lib/paths.ts';
import type { World } from '../lib/validate.ts';

interface Props {
  title: string;
  description: string;
  world?: World | null;
  /** Set false on pages that draw their own top bar, such as the gateway. */
  nav?: boolean;
  /** The picture shown when the page is shared. Defaults to the card for its world. */
  image?: string;
  /** True for reviews and rundowns. */
  article?: boolean;
  /** A structured description of the page for search engines. */
  jsonLd?: unknown;
}
const { title, description, world = null, nav = true, image, article = false, jsonLd } = Astro.props;
const fullTitle = title === 'CaskScents' ? title : `${title} · CaskScents`;
const previewing = showDrafts && import.meta.env.PROD;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = absoluteUrl(Astro.site!, import.meta.env.BASE_URL, image ?? defaultCard(world));
const feeds: World[] = world ? [world] : ['whiskey', 'fragrance'];
// Visits are only counted on the real site, and only once a token is set.
const analytics = import.meta.env.PROD && !previewing ? import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN : undefined;
---

<!doctype html>
<html lang="en" data-world={world ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14100d" />
    {previewing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href={href('/favicon-48.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={href('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    {
      feeds.map((feed) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`CaskScents ${feed === 'whiskey' ? 'Whiskey' : 'Fragrance'}`}
          href={href(feedPath(feed))}
        />
      ))
    }
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd ? <script type="application/ld+json" is:inline set:html={jsonLdText(jsonLd)} /> : null}
    {
      analytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analytics })}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    {
      previewing && (
        <p class="sample-banner">
          Preview build. Entries marked "Sample" are placeholders and will not be published.
        </p>
      )
    }
    {nav && <SiteNav world={world} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer world={world} />
  </body>
</html>
