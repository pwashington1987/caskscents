---
/** Each flavor or accord compared across the bottles, one bar per bottle. */
import type { RundownView } from '../lib/rundown-view.ts';
interface Props {
  groups: RundownView['profile']['groups'];
}
const { groups } = Astro.props;
---

<div class="groups">
  {
    groups.map((group) => (
      <div class="group">
        <h3>{group.label}</h3>
        <ul>
          {group.rows.map((row) => (
            <li>
              <span class="name">{row.short}</span>
              <span class="track" aria-hidden="true">
                <span class="fill" style={`width:${row.percent}%`} />
              </span>
              <span class="visually-hidden">{row.percent} percent</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  li {
    display: grid;
    grid-template-columns: minmax(5.5rem, 30%) 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  .name {
    font-size: var(--text-xs);
    color: var(--ash-light);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .track {
    display: block;
    height: 7px;
    background: var(--rule);
    border-radius: 4px;
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 4px;
  }
</style>
