---
/** The closing line on every page. The whiskey world adds a drinking note. */
import { href } from '../lib/href.ts';
import { feedPath } from '../lib/paths.ts';
import { aboutPage } from '../lib/site.ts';
import type { World } from '../lib/validate.ts';
interface Props {
  world: World | null;
}
const { world } = Astro.props;
const about = await aboutPage();
const sense = world === 'fragrance' ? 'nose' : world === 'whiskey' ? 'palate' : 'palate and nose';
---

<footer class="footer wrap">
  <span class="name">CaskScents</span>
  <p>
    Scores are one person's {sense}. Prices are what I paid.
    {world !== 'fragrance' && ' Please drink responsibly.'}
  </p>
  <nav aria-label="About">
    {about && <a href={href('/about/')}>About</a>}
    <a href={href('/about/scoring/')}>How I score</a>
    {world && <a href={href(feedPath(world))}>RSS</a>}
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
    color: var(--ash);
    font-size: var(--text-xs);
  }
  nav {
    display: flex;
    gap: 1.5rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ash-light);
  }
  .name {
    font-family: var(--font-logo);
    font-style: italic;
    font-weight: 500;
    font-size: 1.1875rem;
    color: var(--ash-light);
  }
</style>
