---
/**
 * The shelf's controls: search, one menu per way of filtering, and the sort
 * order. Native menus, so phones show their own pickers.
 */
import { facetLabel, type Facet, type Group } from '../lib/taxonomy.ts';
interface Props {
  facets: { facet: Facet; groups: Group[] }[];
}
const { facets } = Astro.props;
---

<form class="filters" data-filters role="search" aria-label="Filter the shelf">
  <label class="field search">
    <span class="visually-hidden">Search</span>
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="M20 20l-3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
    <input id="search" type="search" name="q" placeholder="Search a bottle, maker or note" autocomplete="off" />
  </label>
  {
    facets.map(({ facet, groups }) => (
      <label class="field">
        <span class="name">{facet.label}</span>
        <select name={facet.param}>
          <option value="">All</option>
          {groups.map((group) => (
            <option value={group.label}>
              {facetLabel(facet, group.label)} ({group.ids.length})
            </option>
          ))}
        </select>
      </label>
    ))
  }
  <label class="field">
    <span class="name">Sort</span>
    <select name="sort">
      <option value="newest">Newest</option>
      <option value="score">Highest score</option>
      <option value="price">Lowest price</option>
      <option value="name">Name</option>
    </select>
  </label>
  <button class="reset" type="reset" data-reset hidden>Clear</button>
</form>

<style>
  .filters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: end;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .name {
    font-size: var(--text-xs);
    color: var(--ash);
  }
  .search {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: center;
    gap: 0.625rem;
    padding: 0 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--ash-light);
  }
  .search:focus-within {
    border-color: var(--gold);
  }
  input,
  select {
    width: 100%;
    min-height: 44px;
    background: transparent;
    color: var(--bone);
    font-size: 1rem;
  }
  input {
    border: none;
    outline: none;
  }
  input::placeholder {
    color: var(--ash);
  }
  select {
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--ink);
  }
  .reset {
    min-height: 44px;
    padding: 0 1rem;
    background: none;
    border: none;
    color: var(--accent-text);
    font-size: var(--text-sm);
    cursor: pointer;
    justify-self: start;
  }

  @media (min-width: 860px) {
    .filters {
      grid-template-columns: minmax(16rem, 2fr) repeat(4, minmax(0, 1fr)) auto;
    }
    .search {
      grid-column: auto;
      align-self: end;
    }
    input,
    select {
      font-size: var(--text-sm);
    }
  }
</style>
