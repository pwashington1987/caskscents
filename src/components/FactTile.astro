---
/** A small labeled fact, with an optional five-step gauge under it. */
import type { Tile } from '../lib/review-view.ts';
interface Props {
  tile: Tile;
}
const { tile } = Astro.props;
---

<div class="tile">
  <span class="muted label-text">{tile.label}</span>
  <span class="value">{tile.value}</span>
  {
    tile.level !== undefined && (
      <span class="segments" aria-hidden="true">
        {[1, 2, 3, 4, 5].map((step) => <span class={step <= tile.level! ? 'on' : ''} />)}
      </span>
    )
  }
</div>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .label-text {
    font-size: var(--text-xs);
  }
  .value {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .segments {
    display: flex;
    gap: 3px;
    margin-top: 0.25rem;
  }
  .segments span {
    flex: 1;
    height: 6px;
    border-radius: 2px;
    background: var(--border);
  }
  .segments .on {
    background: var(--accent);
  }
</style>
