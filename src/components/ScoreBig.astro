---
/** The overall score, large. */
interface Props {
  value: string;
}
const { value } = Astro.props;
---

<p class="score-big">
  <span class="score number">{value}</span>
  <span class="muted caption">Overall, out of 10</span>
</p>

<style>
  .score-big {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .number {
    font-size: clamp(3.5rem, 2.6rem + 3.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .caption {
    font-size: var(--text-xs);
  }
</style>
