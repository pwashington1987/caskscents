---
/**
 * One bottle in a list. On phones it is a compact row; on wide screens it
 * becomes a card with the photo on top.
 */
import BottlePhoto from './BottlePhoto.astro';
import { href } from '../lib/href.ts';
import { reviewPath } from '../lib/paths.ts';
import type { ReviewView } from '../lib/review-view.ts';
interface Props {
  id: string;
  view: ReviewView;
  /** Show the one-line summary under the meta line on wide screens. */
  summary?: boolean;
  /** Stay a compact row at every width. */
  row?: boolean;
  /** Show the overall score. The gateway leaves it out, so readers open the review to see it. */
  score?: boolean;
}
const { id, view, summary = true, row = false, score = true } = Astro.props;
---

<a class={`card ${row ? 'row-only' : ''}`} href={href(reviewPath(view.world, id))}>
  <span class="photo">
    <BottlePhoto world={view.world} name={view.name} image={view.image} width={120} />
  </span>
  <span class="text">
    <span class="top">
      <span class="display name">{view.name}</span>
      {score ? <span class="score">{view.overall}</span> : <span class="go" aria-hidden="true">→</span>}
    </span>
    <span class="muted meta">{view.cardMeta}</span>
    {summary && <span class="summary">{view.summary}</span>}
  </span>
</a>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--rule);
    color: var(--bone);
    height: 100%;
  }
  .card:hover .name {
    color: var(--accent-text);
  }
  .photo {
    flex: none;
    width: 2.25rem;
    display: flex;
    justify-content: center;
  }
  .photo :global(svg),
  .photo :global(img) {
    width: 100%;
    height: auto;
  }
  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .name {
    font-size: 1.25rem;
    line-height: 1.2;
    transition: color 200ms var(--ease);
  }
  .score {
    font-size: 1.1875rem;
  }
  .go {
    color: var(--accent-text);
    transition: transform 200ms var(--ease);
  }
  .card:hover .go {
    transform: translateX(3px);
  }
  .meta {
    font-size: var(--text-xs);
  }
  .summary {
    display: none;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--bone-soft);
  }

  @media (min-width: 720px) {
    .card:not(.row-only) {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding-block: 1.5rem 0.5rem;
    }
    .card:not(.row-only) .photo {
      width: auto;
      height: 11rem;
      align-items: flex-end;
    }
    .card:not(.row-only) .photo :global(svg),
    .card:not(.row-only) .photo :global(img) {
      width: auto;
      height: 100%;
    }
    .card:not(.row-only) .name {
      font-size: 1.375rem;
    }
    .card:not(.row-only) .summary {
      display: block;
      margin-top: 0.25rem;
    }
  }
</style>
