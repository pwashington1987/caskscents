---
/**
 * "Why, score by score" for phones: one collapsible row per attribute that
 * opens to every bottle's score and note, highest first. No script needed.
 */
import type { RundownView } from '../lib/rundown-view.ts';
interface Props {
  view: RundownView;
}
const { view } = Astro.props;
---

<div class="accordion">
  {
    view.attributes.map((attribute, index) => (
      <details open={index === 0}>
        <summary>
          <span class="text">
            <span class="name">{attribute.label}</span>
            <span class="top muted">Top: {attribute.top}</span>
          </span>
          <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </summary>
        <ul>
          {attribute.ranked.map((cell) => (
            <li>
              <span class="row">
                <span class="display bottle">{cell.name}</span>
                <span class={`num ${cell.best ? 'best' : ''}`}>{cell.score}</span>
              </span>
              <span class="note">{cell.note}</span>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
  {
    view.value && (
      <details>
        <summary>
          <span class="text">
            <span class="name">Value</span>
            <span class="top muted">In words. Not part of the score.</span>
          </span>
          <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </summary>
        <ul>
          {view.value.map((cell) => (
            <li>
              <span class="row">
                <span class="display bottle">{cell.name}</span>
              </span>
              <span class="note">{cell.note || 'Not covered in this review.'}</span>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</div>

<style>
  details {
    border-top: 1px solid var(--border);
  }
  details:last-child {
    border-bottom: 1px solid var(--border);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.5rem;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .name {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .top {
    font-size: var(--text-xs);
  }
  details[open] .top {
    display: none;
  }
  .chevron {
    flex: none;
    color: var(--ash-light);
    transition: transform 300ms var(--ease);
  }
  details[open] .chevron {
    transform: rotate(180deg);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.25rem 0 1.375rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .bottle {
    font-size: 1.1875rem;
    line-height: 1.2;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
  }
  .best {
    color: var(--gold);
  }
  .note {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--ash-light);
  }
</style>
