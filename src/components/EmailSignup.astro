---
/**
 * Email signup through Buttondown. It only appears once the newsletter name
 * is set (PUBLIC_BUTTONDOWN_USERNAME), so there is never a form that goes nowhere.
 */
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME;
---

{
  username && (
    <form
      class="signup"
      action={`https://buttondown.com/api/emails/embed-subscribe/${username}`}
      method="post"
    >
      <label for="signup-email">New reviews and rundowns, by email</label>
      <div class="row">
        <input id="signup-email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
        <button type="submit">Subscribe</button>
      </div>
      <p class="muted">One email when something new is published. Nothing else.</p>
    </form>
  )
}

<style>
  .signup {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  label {
    font-size: var(--text-base);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  input {
    flex: 1 1 14rem;
    min-height: 50px;
    padding: 0 1rem;
    background: var(--umber);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 1rem;
  }
  button {
    min-height: 50px;
    padding: 0 1.625rem;
    background: var(--gold);
    border: none;
    border-radius: 6px;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }
  p {
    font-size: var(--text-xs);
  }
</style>
